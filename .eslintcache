;\r\n\r\n    const showButton = () => {\r\n        if (window.innerWidth <= 960) {\r\n            setButton(false)\r\n        } else {\r\n            setButton(true)\r\n        }\r\n    };\r\n\r\n    useEffect(() => {\r\n        showButton();\r\n\r\n    }, [])\r\n\r\n    window.addEventListener('resize', showButton);\r\n\r\n    return (\r\n        <>\r\n            <IconContext.Provider value={{ color: '#242424' }}>\r\n                <div className=\"navbar\">\r\n                    <div className=\"navbar-container container\">\r\n                        <Link to='/' className=\"navbar-logo\" onClick={closeMobileMenu}>\r\n                            <div className='firstLogo'>\r\n                                <img src=\"images/logo_4.png\" style={{ width: 50, height: 50, marginRight: 10 }} />\r\n                            </div>\r\n                            <div className='secondLogo'>\r\n                                <img src=\"images/logo_5.png\" style={{ width: 100, height: 50, display: \"flex\", justifyContent: \"flex-start\"}} />\r\n                            </div>\r\n                        </Link>\r\n                        <div className=\"menu-icon\" onClick={handleClick}>\r\n                            {click ? <FaTimes /> : <FaBars />}\r\n                        </div>\r\n                        <ul className={click ? 'nav-menu active' : 'nav-menu'}>\r\n                            <li className=\"nav-item\">\r\n                                <Link to='/' className=\"nav-links\" onClick={closeMobileMenu}>\r\n                                    Inicio\r\n                        </Link>\r\n                            </li>\r\n                            <li className=\"nav-item\">\r\n                                <Link to='/services' className=\"nav-links\" onClick={closeMobileMenu}>\r\n                                    Servicios\r\n                        </Link>\r\n                            </li>\r\n                            <li className=\"nav-item\">\r\n                                <Link to='/contact' className=\"nav-links\" onClick={closeMobileMenu}>\r\n                                    Contacto\r\n                        </Link>\r\n                            </li>\r\n                        </ul>\r\n                    </div>\r\n                </div>\r\n            </IconContext.Provider>\r\n        </>\r\n    )\r\n}\r\n\r\nexport default Navbar\r\n","D:\\Danny\\PROYECTOS\\Eterux\\eterux-web-page\\src\\components\\Button.js",[],"D:\\Danny\\PROYECTOS\\Eterux\\eterux-web-page\\src\\components\\pages\\HomePage\\Home.js",["83","84","85"],"import React from 'react'\r\nimport HeroSection from '../../HeroSection'\r\nimport Pricing from '../../Pricing'\r\nimport {homeObjOne, homeObjTwo, homeObjThree, homeObjFour} from './Data'\r\n\r\nfunction Home() {\r\n    return (\r\n        <>\r\n            <HeroSection {...homeObjOne}/>\r\n            <Pricing/>\r\n        </>\r\n    )\r\n}\r\n\r\nexport default Home\r\n","D:\\Danny\\PROYECTOS\\Eterux\\eterux-web-page\\src\\components\\pages\\HomePage\\Data.js",[],"D:\\Danny\\PROYECTOS\\Eterux\\eterux-web-page\\src\\components\\HeroSection.js",[],"D:\\Danny\\PROYECTOS\\Eterux\\eterux-web-page\\src\\components\\pages\\Footer\\Footer.js",["86","87","88","89"],"D:\\Danny\\PROYECTOS\\Eterux\\eterux-web-page\\src\\components\\Pricing.js",[],"D:\\Danny\\PROYECTOS\\Eterux\\eterux-web-page\\src\\components\\pages\\Services\\Services.js",["90"],"import React from 'react'\r\nimport HeroSection from '../../HeroSection'\r\nimport Pricing from '../../Pricing'\r\n\r\nfunction Services() {\r\n    return (\r\n        <>\r\n            <Pricing/>\r\n        </>\r\n    )\r\n}\r\n\r\nexport default Services\r\n","D:\\Danny\\PROYECTOS\\Eterux\\eterux-web-page\\src\\components\\pages\\AboutUS\\AboutUs.js",[],"D:\\Danny\\PROYECTOS\\Eterux\\eterux-web-page\\src\\components\\pages\\AboutUS\\components\\Data.js",[],"D:\\Danny\\PROYECTOS\\Eterux\\eterux-web-page\\src\\components\\