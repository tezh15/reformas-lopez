enu = () => setClick(false);\r\n\r\n    const showButton = () => {\r\n        if (window.innerWidth <= 960) {\r\n            setButton(false)\r\n        } else {\r\n            setButton(true)\r\n        }\r\n    };\r\n\r\n    useEffect(() => {\r\n        showButton();\r\n\r\n    }, [])\r\n\r\n    window.addEventListener('resize', showButton);\r\n\r\n    return (\r\n        <>\r\n            <IconContext.Provider value={{ color: '#242424' }}>\r\n                <div className=\"navbar\">\r\n                    <div className=\"navbar-container container\">\r\n                        <Link to='/' className=\"navbar-logo\" onClick={closeMobileMenu}>\r\n                            <div className='firstLogo'>\r\n                                <img src=\"images/logo_4.png\" style={{ width: 50, height: 50, marginRight: 10 }} />\r\n                            </div>\r\n                            <div className='secondLogo'>\r\n                                <img src=\"images/logo_5.png\" style={{ width: 100, height: 50, display: \"flex\", justifyContent: \"flex-start\"}} />\r\n                            </div>\r\n                        </Link>\r\n                        <div className=\"menu-icon\" onClick={handleClick}>\r\n                            {click ? <FaTimes /> : <FaBars />}\r\n                        </div>\r\n                        <ul className={click ? 'nav-menu active' : 'nav-menu'}>\r\n                            <li className=\"nav-item\">\r\n                                <Link to='/' className=\"nav-links\" onClick={closeMobileMenu}>\r\n                                    Inicio\r\n                        </Link>\r\n                            </li>\r\n                            <li className=\"nav-item\">\r\n                                <Link to='/services' className=\"nav-links\" onClick={closeMobileMenu}>\r\n                                    Servicios\r\n                        </Link>\r\n                            </li>\r\n                            <li className=\"nav-item\">\r\n                                <Link to='/contact' className=\"nav-links\" onClick={closeMobileMenu}>\r\n                                    Contacto\r\n                        </Link>\r\n                            </li>\r\n                        </ul>\r\n                    </div>\r\n                </div>\r\n            </IconContext.Provider>\r\n        </>\r\n    )\r\n}\r\n\r\nexport default Navbar\r\n","D:\\Danny\\PROYECTOS\\Eterux\\eterux-web-page\\src\\components\\Button.js",[],"D:\\Danny\\PROYECTOS\\Eterux\\eterux-web-page\\src\\components\\pages\\HomePage\\Home.js",["84","85","86"],"import React from 'react'\r\nimport HeroSection from '../../HeroSection'\r\nimport Pricing from '../../Pricing'\r\nimport Contact from '../Contact/Contact'\r\nimport {homeObjOne, homeObjTwo, homeObjThree, homeObjFour} from './Data'\r\n\r\nfunction Home() {\r\n    return (\r\n        <>\r\n            <HeroSection {...homeObjOne}/>\r\n            <Pricing/>\r\n            <Contact/>\r\n        </>\r\n    )\r\n}\r\n\r\nexport default Home\r\n","D:\\Danny\\PROYECTOS\\Eterux\\eterux-web-page\\src\\components\\pages\\HomePage\\Data.js",[],"D:\\Danny\\PROYECTOS\\Eterux\\eterux-web-page\\src\\components\\HeroSection.js",[],"D:\\Danny\\PROYECTOS\\Eterux\\eterux-web-page\\src\\components\\pages\\Footer\\Footer.js",["87","88","89","90"],"import React from 'react';\r\nimport './Footer.css';\r\nimport { Button } from '../../Button';\r\nimport { Link } from 'react-router-dom';\r\nimport {\r\n  FaFacebook,\r\n  FaInstagram,\r\n  FaYoutube,\r\n  FaTwitter,\r\n  FaLinkedin\r\n} from 'react-icons/fa';\r\nimport { MdFingerprint } from 'react-icons/md';\r\n\r\nfunction Footer() {\r\n  return (\r\n    <div className='footer-container'>\r\n      <div className='footer-links'>\r\n        <div className='footer-link-wrapper'>\r\n          <div className='footer-link-items'>\r\n            <h2>Sobre nosotros</h2>\r\n            <Link to='/about-us'>Sobre nosotros</Link>\r\n            <Link to='/'>Portafolio</Link>\r\n            <Link to='/'>Servicios</Link>\r\n            <Link to='/'>Términos y condiciones</Link>\r\n          </div>\r\n          <div className='footer-link-items'>\r\n            <h2>Contáctanos</h2>\r\n            <Link to='/contact'>Contacto</Link>\r\n            <Link to='/contact'>Solicitudes</Link>\r\n            <Link to='/'>Destinations</Link>\r\n            <Link to='/'>Sponsorships</Link>\r\n          </div>\r\n          <div className='footer-link-items'>\r\n            <h2>Redes Sociales</h2>\r\n            <Link to='/'>Instagram</Link>\r\n            <Link to='/'>Facebook</Link>\r\n            <Link to='/'>Youtube</Link>\r\n            <Link to='/'>Twitter</Link>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <section className='social-media'>\r\n        <div className='social-media-wrap'>\r\n          <div className='footer-logo'>\r\n            <Link to='/' className=\"navbar-logo\">\r\n              <div className='firstLogo'>\r\n                <img src=\"images/logo_4.png\" style={{ width: 50, height: 50, marginRight: 10 }} />\r\n              </div>\r\n              <div className='secondLogo'>\r\n                <img src=\"images/logo_5.png\" style={{ width: 100, height: 50, display: \"flex\", justifyContent: \"flex-start\" }} />\r\n              </div>\r\n            </Link>\r\n          </div>\r\n          <small className='website-rights'>ETERUX © 2020</small>\r\n          <div className='social-icons'>\r\n            <Link\r\n              className='social-icon-link'\r\n              to='/'\r\n              target='_blank'\r\n              aria-label='Facebook'>\r\n              <FaFacebook />\r\n            </Link>\r\n            <Link\r\n              className='social-icon-link'\r\n              to='/'\r\n              target='_blank'\r\n              aria-label='Instagram'\r\n            >\r\n              <FaInstagram />\r\n            </Link>\r\n            <Link\r\n              className='social-icon-link'\r\n              to={\r\n                '//www.youtube.com/channel/UCsKsymTY_4BYR-wytLjex7A?view_as=subscriber'\r\n              }\r\n              target='_blank'\r\n              aria-label='Youtube'\r\n            >\r\n              <FaYoutube />\r\n            </Link>\r\n            <Link\r\n              className='social-icon-link'\r\n              to='/'\r\n              target='_blank'\r\n              aria-label='Twitter'\r\n            >\r\n              <FaTwitter />\r\n            </Link>\r\n            <Link\r\n              className='social-icon-link'\r\n              to='/'\r\n              target='_blank'\r\n              aria-label='LinkedIn'\r\n            >\r\n              <FaLinkedin />\r\n            </Link>\r\n          </div>\r\n        </div>\r\n      </section>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default Footer;","D:\\Danny\\PROYECTOS\\Eterux\\eterux-web-page\\src\\components\\Pricing.js",[],"D:\\Danny\\PROYECTOS\\Eterux\\eterux-web-page\\src\\components\\pages\\AboutUS\\AboutUs.js",[],"D:\\Danny\\PROYECTOS\\Eterux\\eterux-web-page\\src\\components\\pages\\AboutUS\\components\\Data.js",[],"D:\\Danny\\PROYECTOS\\Eterux\\eterux-web-page\\src\\components\\pages\\AboutUS\\components\\AboutUsSection.js",["91"],"import React from 'react';\r\nimport '../css/AboutUsSection.css';\r\nimport { Link } from 'react-router-dom';\r\n\r\nfunction HeroSection({\r\n  lightBg,\r\n  lightText,\r\n  headline,\r\n  description,\r\n  descriptionTwo,\r\n  descriptionThree\r\n}) {\r\n  return (\r\n    <>\r\n      <div className={lightBg ? 'AboutUs__hero-section' : 'AboutUs__hero-section darkBg'}>\r\n        <div className='container'>\r\n          <h1 className={lightText ? 'heading' : 'heading dark'}>\r\n            {headline}\r\n          </h1>\r\n          <p className='dark'>\r\n            {description}\r\n          </p>\r\n          <h1 className={lightText ? 'heading' : 'heading dark'}>Misión<