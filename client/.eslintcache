bleWarningCount":0,"source":"88","usedDeprecatedRules":"51"},{"filePath":"89","messages":"90","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"51"},{"filePath":"91","messages":"92","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"93","messages":"94","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"D:\\Danny\\PROYECTOS\\eterux_landing\\client\\src\\index.js",[],"D:\\Danny\\PROYECTOS\\eterux_landing\\client\\src\\App.js",["95"],"D:\\Danny\\PROYECTOS\\eterux_landing\\client\\src\\components\\Navbar.js",["96","97","98","99","100"],"import React, { useState, useEffect } from 'react';\r\nimport { Link } from 'react-router-dom';\r\nimport { MdFingerprint } from 'react-icons/md';\r\nimport { FaBars, FaTimes } from 'react-icons/fa';\r\nimport { Button } from './Button';\r\nimport './Navbar.css';\r\nimport { IconContext } from 'react-icons/lib'\r\n\r\n\r\nfunction Navbar() {\r\n\r\n    const [click, setClick] = useState(false);\r\n    const [button, setButton] = useState(true);\r\n\r\n\r\n    const handleClick = () => setClick(!click);\r\n    const closeMobileMenu = () => setClick(false);\r\n\r\n    const showButton = () => {\r\n        if (window.innerWidth <= 960) {\r\n            setButton(false)\r\n        } else {\r\n            setButton(true)\r\n        }\r\n    };\r\n\r\n    useEffect(() => {\r\n        showButton();\r\n\r\n    }, [])\r\n\r\n    window.addEventListener('resize', showButton);\r\n\r\n    return (\r\n        <>\r\n            <IconContext.Provider value={{ color: '#242424' }}>\r\n                <div className=\"navbar\">\r\n                    <div className=\"navbar-container container\">\r\n                        <Link to='/' className=\"navbar-logo\" onClick={closeMobileMenu}>\r\n                            <div className='firstLogo'>\r\n                                <img src=\"images/logo_4.png\" style={{ width: 50, height: 50, marginRight: 10 }} />\r\n                            </div>\r\n                            <div className='secondLogo'>\r\n                                <img src=\"images/logo_5.png\" style={{ width: 100, height: 50, display: \"flex\", justifyContent: \"flex-start\"}} />\r\n                            </div>\r\n                        </Link>\r\n                        <div className=\"menu-icon\" onClick={handleClick}>\r\n                            {click ? <FaTimes /> : <FaBars />}\r\n                        </div>\r\n                        <ul className={click ? 'nav-menu active' : 'nav-menu'}>\r\n                            <li className=\"nav-item\">\r\n                                <Link to='/' className=\"nav-links\" onClick={closeMobileMenu}>\r\n                                    Inicio\r\n                        </Link>\r\n                            </li>\r\n                            <li className=\"nav-item\">\r\n                                <Link to='/services' className=\"nav-links\" onClick={closeMobileMenu}>\r\n                                    Servicios\r\n                        </Link>\r\n                            </li>\r\n                            <li className=\"nav-item\">\r\n                                <Link to='/contact' className=\"nav-links\" onClick={closeMobileMenu}>\r\n                                    Contacto\r\n                        </Link>\r\n                            </li>\r\n                        </ul>\r\n                    </div>\r\n                </div>\r\n            </IconContext.Provider>\r\n        </>\r\n    )\r\n}\r\n\r\nexport default Navbar\r\n",["101","102"],"D:\\Danny\\PROYECTOS\\eterux_landing\\client\\src\\components\\pages\\Products\\Services.js",["103"],"import React from 'react'\r\nimport HeroSection from '../../HeroSection'\r\nimport Pricing from '../../Pricing'\r\n\r\nfunction Services() {\r\n    return (\r\n        <>\r\n            <Pricing/>\r\n        </>\r\n    )\r\n}\r\n\r\nexport default Services\r\n","D:\\Danny\\PROYECTOS\\eterux_landing\\client\\src\\components\\pages\\Contact\\Contact.js",["104"],"import React from 'react'\r\nimport ContactUsSection from './components/ContactUsSection'\r\nimport ContactForm from \"./components/ContactForm\"\r\nimport { contactObjOne } from './components/Data'\r\n\r\nfunction Contact() {\r\n    return (\r\n        <>\r\n            <div className=\"mainSection\">\r\n                <div className=\"container\">\r\n                    <div className=\"row\">\r\n                        <h1 style={{ marginBottom: 20 }}>Contáctanos</h1>\r\n                        <div className=\"col-lg-6\">\r\n                            <ContactUsSection />\r\n                        </div>\r\n                        <div className=\"col-lg-6\">\r\n                            <ContactForm />\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </>\r\n    )\r\n}\r\n\r\nexport default Contact\r\n","D:\\Danny\\PROYECTOS\\eterux_landing\\client\\src\\components\\pages\\HomePage\\Home.js",["105","106","107"],"import React from 'react'\r\nimport HeroSection from '../../HeroSection'\r\nimport Pricing from '../../Pricing'\r\nimport Contact from '../Contact/Contact'\r\nimport {homeObjOne, homeObjTwo, homeObjThree, homeObjFour} from './Data'\r\n\r\nfunction Home() {\r\n    return (\r\n        <>\r\n            <HeroSection {...homeObjOne}/>\r\n            <Pricing/>\r\n            <Contact/>\r\n        </>\r\n    )\r\n}\r\n\r\nexport default Home\r\n","D:\\Danny\\PROYECTOS\\eterux_landing\\client\\src\\components\\pages\\Footer\\Footer.js",["108","109","110","111"],"import React from 'react';\r\nimport './Footer.css';\r\nimport { Button } from '../../Button';\r\nimport { Link } from 'react-router-dom';\r\nimport {\r\n  FaFacebook,\r\n  FaInstagram,\r\n  FaYoutube,\r\n  FaTwitter,\r\n  FaLinkedin\r\n} from 'react-icons/fa';\r\nimport { MdFingerprint } from 'react-icons/md';\r\n\r\nfunction Footer() {\r\n  return (\r\n    <div className='footer-container'>\r\n      <div className='footer-links'>\r\n        <div className='footer-link-wrapper'>\r\n          <div className='footer-link-items'>\r\n            <h2>Sobre nosotros</h2>\r\n            <Link to='/about-us'>Sobre nosotros</Link>\r\n            <Link to='/'>Portafolio</Link>\r\n            <Link to='/'>Servicios</Link>\r\n            <Link to='/'>Términos y condiciones</Link>\r\n          </div>\r\n          <div className='footer-link-items'>\r\n            <h2>Contáctanos</h2>\r\n            <Link to='/contact'>Contacto</Link>\r\n            <Link to='/contact'>Solicitudes</Link>\r\n            <Link to='/'>Destinations</Link>\r\n            <Link to='/'>Sponsorships</Link>\r\n          </div>\r\n          <div className='footer-link-items'>\r\n            <h2>Redes Sociales</h2>\r\n            <Link to='/'>Instagram</Link>\r\n            <Link to='/'>Facebook</Link>\r\n            <Link to='/'>Youtube</Link>\r\n            <Link to='/'>Twitter</Link>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <section className='social-media'>\r\n        <div className='social-media-wrap'>\r\n          <div className='footer-logo'>\r\n            <Link to='/' className=\"navbar-logo\">\r\n              <div className='firstLogo'>\r\n                <img src=\"images/logo_4.png\" style={{ width: 50, height: 50, marginRight: 10 }} />\r\n              </div>\r\n              <div className='secondLogo'>\r\n                <img src=\"images/logo_5.png\" style={{ width: 100, height: 50, display: \"flex\", justifyContent: \"flex-start\" }} />\r\n              </div>\r\n            </Link>\r\n          </div>\r\n          <small className='website-rights'>ETERUX © 2020</small>\r\n          <div className='social-icons'>\r\n            <Link\r\n              className='social-icon-link'\r\n              to='/'\r\n              target='_blank'\r\n              aria-label='Facebook'>\r\n              <FaFacebook />\r\n            </Link>\r\n            <Link\r\n              className='social-icon-link'\r\n              to='/'\r\n              target='_blank'\r\n              aria-label='Instagram'\r\n            >\r\n              <FaInstagram />\r\n            </Link>\r\n            <Link\r\n              className='social-icon-link'\r\n              to={\r\n                '//www.youtube.com/channel/UCsKsymTY_4BYR-wytLjex7A?view_as=subscriber'\r\n              }\r\n              target='_blank'\r\n              aria-label='Youtube'\r\n            >\r\n              <FaYoutube />\r\n            </Link>\r\n            <Link\r\n              className='social-icon-link'\r\n              to='/'\r\n              target='_blank'\r\n              aria-label='Twitter'\r\n            >\r\n              <FaTwitter />\r\n            </Link>\r\n            <Link\r\n              className='social-icon-link'\r\n              to='/'\r\n              target='_blank'\r\n              aria-label='LinkedIn'\r\n            >\r\n              <FaLinkedin />\r\n            </Link>\r\n          </div>\r\n        </div>\r\n      </section>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default Footer;","D:\\Danny\\PROYECTOS\\eterux_landing\\client\\src\\components\\pages\\AboutUS\\AboutUs.js",[],"D:\\Danny\\PROYECTOS\\eterux_landing\\client\\src\\components\\Button.js",[],"D:\\Danny\\PROYECTOS\\eterux_landing\\client\\src\\components\\HeroSection.js",[],"D:\\Danny\\PROYECTOS\\eterux_landing\\client\\src\\components\\Pricing.js",[],"D:\\Danny\\PROYECTOS\\eterux_landing\\client\\src\\components\\pages\\HomePage\\Data.js",[],"D:\\Danny\\PROYECTOS\\eterux_landing\\client\\src\\components\\pages\\Contact\\components\\Data.js",[],"D:\\Danny\\PROYECTOS\\eterux_landing\\client\\src\\components\\pages\\Contact\\components\\ContactUsSection.js",["112","113"],"import React, { useState } from 'react';\r\nimport '../css/ContactSection.css';\r\nimport { Link } from 'react-router-dom';\r\nimport Toast from '../../../toast/Toast';\r\nimport { sendEmailApi } from '../services';\r\nimport axios from 'axios';\r\n\r\nfunction ContactUsSection() {\r\n  const [formData, setFormData] = useState({\r\n    name: '',\r\n    email: '',\r\n    comments: ''\r\n  });\r\n\r\n  const [configToast, setConfigToast] = useState({\r\n    typeToast: '',\r\n    textToast: ''\r\n\r\n  });\r\n\r\n  const [isLoading, setIsLoading] = useState(false);\r\n\r\n  const handleChange = (event) => {\r\n    const { name, value } = event.target\r\n    setFormData({ ...formData, [name]: value });\r\n  }\r\n\r\n  let componentToast = () => {\r\n    if (configToast.typeToast !== '') {\r\n      return <Toast typeToast={configToast.typeToast}\r\n        changeError={changeError}\r\n        textToast={configToast.textToast} />\r\n    } else {\r\n      return null\r\n    }\r\n  }\r\n\r\n  const changeError = () => {\r\n    setConfigToast({ ...configToast, typeToast: '', textToast: '' });\r\n  }\r\n\r\n  async function handleSubmit(e) {\r\n    e.preventDefault();\r\n    setIsLoading(true);\r\n    // setConfigToast({ ...configToast, typeToast: \"done\", textToast: \"Email sent\" });\r\n    const response = await sendEmailApi(formData);\r\n    if (typeof response !== 'undefined') {\r\n      if (response.data.done) {\r\n        setConfigToast({ ...configToast, typeToast: \"done\", textToast: response.data.done });\r\n        setIsLoading(false);\r\n      }\r\n      if (response.data.info) {\r\n        setConfigToast({ ...configToast, typeToast: \"info\", textToast: response.data.info });\r\n        setIsLoading(false);\r\n      }\r\n      if (response.data.error) {\r\n        setConfigToast({ ...configToast, typeToast: \"error\", textToast: response.data.error });\r\n        setIsLoading(false);\r\n      }\r\n    } else {\r\n      console.log(\"problema en la peticion\");\r\n      setConfigToast({ ...configToast, typeToast: \"error\", textToast: \"Server Off\" });\r\n      setIsLoading(false);\r\n      return\r\n    }\r\n  }\r\n\r\n  return (\r\n    <>\r\n      {componentToast()}\r\n      <form onSubmit={handleSubmit} className=\"row-mb-3\">\r\n        <div className=\"col-md-12\">\r\n          <label htmlFor=\"FormControlInput1\" className=\"form-label\">Nombre completo *</label>\r\n          <input style={{ marginBottom: 10 }} type=\"text\" name=\"name\" className=\"form-control\" id=\"FormControlInput1\"\r\n            placeholder=\"Nombre\" onChange={handleChange} value={formData.name} required />\r\n        </div>\r\n        <div className=\"col-md-12\">\r\n          <label htmlFor=\"FormControlInput2\" className=\"form-label\">Email *</label>\r\n          <input style={{ marginBottom: 10 }} type=\"email\" name=\"email\" className=\"form-control\" id=\"FormControlInput2\"\r\n            placeholder=\"name@example.com\" onChange={handleChange} value={formData.email} required />\r\n\r\n        </div>\r\n        <div className=\"mb-3\">\r\n          <label htmlFor=\"ControlTextarea1\" className=\"form-label\">Comentarios *</label>\r\n          <textarea className=\"form-control\" id=\"ControlTextarea1\" value={formData.comments} name=\"comments\" rows=\"3\"\r\n            onChange={handleChange} required />\r\n        </div>\r\n        {isLoading ?\r\n          <div style={{ marginBottom: 20 }}>\r\n            <button className=\"btn btn-primary\">\r\n              <span className=\"spinner-border spinner-border-sm\" role=\"status\" aria-hidden=\"true\"></span>\r\n            </button>\r\n          </div>\r\n          :\r\n          <div style={{ marginBottom: 20 }}>\r\n            <button className=\"btn btn-primary\">Enviar</button>\r\n          </div>\r\n        }\r\n\r\n\r\n      </form>\r\n    </>\r\n  );\r\n}\r\n\r\nexport default ContactUsSection;","D:\\Danny\\PROYECTOS\\eterux_landing\\client\\src\\components\\pages\\Contact\\components\\ContactForm.js",[],"D:\\Danny\\PROYECTOS\\eterux_landing\\client\\src\\components\\pages\\AboutUS\\components\\Data.js",[],"D:\\Danny\\PROYECTOS\\eterux_landing\\client\\src\\components\\pages\\AboutUS\\components\\AboutUsSection.js",["114"],"import React from 'react';\r\nimport '../css/AboutUsSection.css';\r\nimport { Link } from 'react-router-dom';\r\n\r\nfunction HeroSection({\r\n  lightBg,\r\n  lightText,\r\n  headline,\r\n  description,\r\n  descriptionTwo,\r\n  descriptionThree\r\n}) {\r\n  return (\r\n    <>\r\n      <div className={lightBg ? 'AboutUs__hero-section' : 'AboutUs__hero-section darkBg'}>\r\n        <div className='container'>\r\n          <h1 className={lightText ? 'heading' : 'heading dark'}>\r\n            {headline}\r\n          </h1>\r\n          <p className='dark'>\r\n            {description}\r\n          </p>\r\n          <h1 className={lightText ? 'heading' : 'heading dark'}>Misión</h1>\r\n          <p className='dark'>\r\n            {descriptionTwo}\r\n          </p>\r\n          <h1 className={lightText ? 'heading' : 'heading dark'}>Visión</h1>\r\n          <p className='dark'>\r\n            {descriptionThree}\r\n          </p>\r\n        </div>\r\n      </div>\r\n    </>\r\n  );\r\n}\r\n\r\nexport default HeroSection;","D:\\Danny\\PROYECTOS\\eterux_landing\\client\\src\\components\\toast\\Toast.js",["115"],"import React, { useState, useEffect } from 'react';\r\nimport { ImCheckmark, ImCancelCircle, ImInfo, ImWarning } from \"react-icons/im\";\r\nimport './Toast.css';\r\nconst Toast = (props) => {\r\n    const { typeToast, changeError, textToast } = props;\r\n    const [list, setList] = useState([]);\r\n\r\n    const deleteToast = id => {\r\n        const index = list.findIndex(e => e.id === id);\r\n        list.splice(index, 1);\r\n        setList([...list]);\r\n        changeError();\r\n    }\r\n\r\n    const setToastList = () => {\r\n        switch (typeToast) {\r\n            case \"done\":\r\n                setList([\r\n                    {\r\n                        id: 1,\r\n                        description: textToast,\r\n                        backgroundColor: '#5cb85c',\r\n                        icon: <ImCheckmark style={{ width: 50, height: 50 }} />\r\n                    }\r\n                ]);\r\n                setTimeout(() => {\r\n                    deleteToast(1);\r\n                }, 2000);\r\n                break;\r\n            case \"error\":\r\n                setList([\r\n                    {\r\n                        id: 2,\r\n                        description: textToast,\r\n                        backgroundColor: '#d9534f',\r\n                        icon: <ImCancelCircle style={{ width: 50, height: 50 }} />\r\n                    }\r\n                ]);\r\n                setTimeout(() => {\r\n                    deleteToast(2);\r\n                }, 2000);\r\n                break;\r\n            case \"info\":\r\n                setList([\r\n                    {\r\n                        id: 3,\r\n                        description: textToast,\r\n                        backgroundColor: '#5bc0de',\r\n                        icon: <ImInfo style={{ width: 50, height: 50 }} />\r\n                    }\r\n                ]);\r\n                setTimeout(() => {\r\n                    deleteToast(3);\r\n                }, 2000);\r\n                break;\r\n            case \"warning\":\r\n                setList([\r\n                    {\r\n                        id: 4,\r\n                        description: textToast,\r\n                        backgroundColor: '#f0ad4e',\r\n                        icon: <ImWarning style={{ width: 50, height: 50 }} />\r\n                    }\r\n                ]);\r\n                setTimeout(() => {\r\n                    deleteToast(4);\r\n                }, 2000);\r\n                break;\r\n\r\n            default:\r\n                break;\r\n        }\r\n    }\r\n\r\n    useEffect(() => {\r\n        setToastList();\r\n    }, [typeToast]);\r\n\r\n    return (\r\n        <>\r\n            <div className=\"notification-container bottom-right\">\r\n                {\r\n                    list.map((toast, i) =>\r\n                        <div\r\n                            key={i}\r\n                            className=\"alert alert-dismissible fade show notification toast bottom-right\"\r\n                            style={{ backgroundColor: toast.backgroundColor }}\r\n                        >\r\n                            <div className=\"notification-image\">\r\n                                {toast.icon}\r\n                            </div>\r\n                            <div style={{ textAlign:'center' }}>\r\n                                <p className=\"notification-message\">\r\n                                    {toast.description}\r\n                                </p>\r\n                            </div>\r\n                        </div>\r\n                    )\r\n                }\r\n            </div>\r\n        </>\r\n    )\r\n}\r\nexport default Toast;","D:\\Danny\\PROYECTOS\\eterux_landing\\client\\src\\components\\pages\\Contact\\services\\index.js",[],"D:\\Danny\\PROYECTOS\\eterux_landing\\client\\src\\components\\pages\\KnowMore\\index.js",[],"D:\\Danny\\PROYECTOS\\eterux_landing\\client\\src\\components\\pages\\KnowMore\\components\\ProdutcsInformation.js",[],{"ruleId":"116","severity":1,"message":"117","line":6,"column":8,"nodeType":"118","messageId":"119","endLine":6,"endColumn":16},{"ruleId":"116","severity":1,"message":"120","line":3,"column":10,"nodeType":"118","messageId":"119","endLine":3,"endColumn":23},{"ruleId":"116","severity":1,"message":"121","line":5,"column":10,"nodeType":"118","messageId":"119","endLine":5,"endColumn":16},{"ruleId":"116","severity":1,"message":"122","line":13,"column":12,"nodeType":"118","messageId":"119","endLine":13,"endColumn":18},{"ruleId":"123","severity":1,"message":"124","line":41,"column":33,"nodeType":"125","endLine":41,"endColumn":115},{"ruleId":"123","severity":1,"message":"124","lin